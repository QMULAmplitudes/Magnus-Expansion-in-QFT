bbbd64764bd4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "We", " ", "can", " ", "compute", " ", "the", " ", "symmetry", " ", 
    "factor", " ", "of", " ", "a", " ", "graph", " ", "using", " ", "for", " ", 
    RowBox[{"example", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "generateTranspositions", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"generateTranspositions", "[", 
     RowBox[{"inds_", ",", "n_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Range", "[", "n", "]"}], "/.", "#"}], "&"}], "/@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"inds", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "->", 
          RowBox[{"inds", "[", 
           RowBox[{"[", 
            RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"inds", "[", 
           RowBox[{"[", 
            RowBox[{"i", "+", "1"}], "]"}], "]"}], "->", 
          RowBox[{"inds", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{
          RowBox[{"Length", "[", "inds", "]"}], "-", "1"}]}], "}"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"generateTranspositions", "[", 
     RowBox[{
      RowBox[{"{", "i_", "}"}], ",", "n_"}], "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{"Range", "[", "n", "]"}], "}"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", "graphSymmetryGroup", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"graphSymmetryGroup", "[", "g_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "@", 
          RowBox[{"VertexList", "@", "g"}]}]}], ",", "perms", ",", "rules", ",",
         "graphPerms", ",", "syms", ",", "canEdgeList", ",", "degreeGroups"}],
        "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"canEdgeList", "=", 
        RowBox[{"Sort", "@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"EdgeList", "[", "g", "]"}], "//.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"UndirectedEdge", "[", 
              RowBox[{"x_", ",", "y_"}], "]"}], ":>", 
             RowBox[{"UndirectedEdge", "@@", 
              RowBox[{"Sort", "[", 
               RowBox[{"{", 
                RowBox[{"x", ",", "y"}], "}"}], "]"}]}]}], "}"}]}], ")"}]}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"degreeGroups", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Pick", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", 
            RowBox[{"VertexDegree", "[", "g", "]"}], ",", "#"}], "]"}], "&"}],
          "/@", 
         RowBox[{"Union", "[", 
          RowBox[{"VertexDegree", "[", "g", "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"perms", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"PermutationList", "[", 
           RowBox[{"#", ",", "n"}], "]"}], "&"}], "/@", 
         RowBox[{"GroupElements", "[", "\[IndentingNewLine]", 
          RowBox[{"PermutationGroup", "[", 
           RowBox[{"Join", "@@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"generateTranspositions", "[", 
                RowBox[{"#", ",", "n"}], "]"}], "&"}], "/@", "degreeGroups"}],
              ")"}]}], "]"}], "\[IndentingNewLine]", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rules", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Inner", "[", 
           RowBox[{"Rule", ",", 
            RowBox[{"Range", "[", "n", "]"}], ",", "#", ",", "List"}], "]"}], 
          "&"}], "/@", "perms"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"graphPerms", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"EdgeList", "[", "g", "]"}], "/.", "#"}], "&"}], "/@", 
           "rules"}], ")"}], "//.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"x_", ",", "y_"}], "]"}], ":>", 
           RowBox[{"UndirectedEdge", "@@", 
            RowBox[{"Sort", "[", 
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}], "]"}]}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"syms", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"And", "@@", 
           RowBox[{"Inner", "[", 
            RowBox[{"Equal", ",", "canEdgeList", ",", "#", ",", "List"}], 
            "]"}]}], "&"}], "/@", 
         RowBox[{"(", 
          RowBox[{"Sort", "/@", "graphPerms"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"syms", "=", 
        RowBox[{"syms", "//.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Equal", "[", 
             RowBox[{
              RowBox[{"DirectedEdge", "[", 
               RowBox[{"i_", ",", "j_"}], "]"}], ",", 
              RowBox[{"DirectedEdge", "[", 
               RowBox[{"k_", ",", "l_"}], "]"}]}], "]"}], ":>", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"i", "==", "k"}], "&&", 
              RowBox[{"j", "==", "l"}]}], ")"}]}], ",", 
           RowBox[{
            RowBox[{"Equal", "[", 
             RowBox[{
              RowBox[{"UndirectedEdge", "[", 
               RowBox[{"i_", ",", "j_"}], "]"}], ",", 
              RowBox[{"UndirectedEdge", "[", 
               RowBox[{"k_", ",", "l_"}], "]"}]}], "]"}], ":>", 
            RowBox[{
             RowBox[{"Sort", "[", 
              RowBox[{"{", 
               RowBox[{"i", ",", "j"}], "}"}], "]"}], "==", 
             RowBox[{"Sort", "[", 
              RowBox[{"{", 
               RowBox[{"k", ",", "l"}], "}"}], "]"}]}]}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Pick", "[", 
        RowBox[{"perms", ",", "syms"}], "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9738491526928425`*^9, 3.9738491750247307`*^9}, {
  3.973849468340599*^9, 3.9738496608062267`*^9}, {3.9738496925478306`*^9, 
