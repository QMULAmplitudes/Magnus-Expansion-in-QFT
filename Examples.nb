Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "general", " ", "expansion", " ", "of", " ", "the", " ", 
     "N"}], "-", 
    RowBox[{"operator", " ", "is", " ", "given", " ", "in", " ", 
     RowBox[{"(", "6.18", ")"}], " ", "of", " ", "the", " ", 
     RowBox[{"paper", "."}]}]}], "*)"}], " ", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "coefficients", " ", "we", " ", "include", " ", "in", " ", 
     "these", " ", "files", " ", "are", " ", "the", " ", "ratio", "  ", 
     FractionBox[
      RowBox[{"\[Omega]", 
       RowBox[{"(", "\[Tau]", ")"}]}], 
      RowBox[{"\[Sigma]", 
       RowBox[{"(", "\[Tau]", ")"}]}]], 
     FractionBox["1", 
      RowBox[{"(", 
       RowBox[{"Degree", " ", "factors"}], ")"}]]}], ",", " ", 
    RowBox[{"where", " ", 
     RowBox[{"(", 
      RowBox[{"Degree", " ", "factors"}], ")"}], " ", "are", " ", "the", " ", 
     RowBox[{"n", "!"}], " ", "type", " ", "terms", " ", "that", " ", 
     "appear", " ", "with", " ", "external", " ", "vertices", " ", "of", " ", 
     "a", " ", "graph"}], ",", " ", 
    RowBox[{"see", " ", "for", " ", "example", " ", 
     RowBox[{"(", "6.19", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"To", " ", "extract", " ", "the", " ", "ratio", " ", 
     FractionBox[
      RowBox[{"\[Omega]", 
       RowBox[{"(", "\[Tau]", ")"}]}], 
      RowBox[{"\[Sigma]", 
       RowBox[{"(", "\[Tau]", ")"}]}]]}], ",", " ", 
    RowBox[{
    "we", " ", "can", " ", "just", " ", "multiply", " ", "by", " ", "these", " ", 
     RowBox[{"(", 
      RowBox[{"Degree", " ", "factors"}], ")"}]}], ",", " ", 
    RowBox[{
    "which", " ", "are", " ", "easily", " ", "extracted", " ", "from", " ", 
     "the", " ", "Graph"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"For", " ", 
    RowBox[{"Example", ":"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "degreeFactor", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"degreeFactor", "[", "graph_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"degreesLeft", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"3", "-", "#"}], ")"}], "&"}], "/@", 
         RowBox[{"VertexDegree", "[", "graph", "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Times", "@@", 
       RowBox[{"(", 
        RowBox[{"Factorial", "/@", "degreesLeft"}], ")"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9738491526928425`*^9, 3.9738491750247307`*^9}, {
